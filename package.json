{
  "name": "hs-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hero Siege's world map, with what drops in every zone.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "package:tracker": "node scripts/package-tracker.mjs",
    "data": "node build/run-python.mjs build/build.py",
    "test": "node --test build/tests/*.test.mjs",
    "test:data": "node build/run-python.mjs -m unittest discover -s build/tests -p test_*.py"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "svelte": "^5.0.0",
    "vite": "^5.4.0"
  }
}
